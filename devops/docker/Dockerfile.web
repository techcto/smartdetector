FROM node:26-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY .npmrc ./
COPY submodules/smartdetector-agentcore ./submodules/smartdetector-agentcore
RUN npm ci
FROM deps AS build
COPY . .
RUN npm run build
RUN npm prune --omit=dev
RUN node -e "require('node:fs').rmSync('.next/cache',{recursive:true,force:true})"
FROM node:26-alpine AS prod
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/submodules ./submodules
COPY --from=build /app/.next ./.next
COPY --from=build /app/package.json /app/next.config.mjs ./
COPY devops/docker/https-server.mjs ./https-server.mjs
COPY --from=build /app/public* ./public/
USER node
EXPOSE 3000
CMD ["node","https-server.mjs"]


