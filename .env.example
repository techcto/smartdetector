SMARTDETECTOR_DEPLOYMENT_MODE=saas
SMARTDETECTOR_ROOT_USER=root
SMARTDETECTOR_ROOT_PASSWORD=smartdetector-local-change-me
SMARTDETECTOR_SESSION_SECRET=smartdetector-local-session-secret-change-me
AWS_REGION=us-east-1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
SMARTDETECTOR_AUTOVISION_URL=http://autovision-api:3001
# Installation-level service secret. Never commit the actual value.
SMARTDETECTOR_AUTOVISION_API_KEY=
# Optional. If blank, the stable session secret encrypts provider credentials.
SMARTDETECTOR_PROVIDER_SECRET=
BEDROCK_MODEL_ID=
# Buyer-facing Marketplace listing URL (https://aws.amazon.com/marketplace/pp/prodview-...)
SMARTDETECTOR_MARKETPLACE_URL=

# Optional local MCP sidecar (docker compose --profile agentcore up --build).
# Organization-scoped REST key created in Settings > API keys, not your root password.
SMARTDETECTOR_MCP_API_KEY=
# A different random 32+ character token for local MCP clients.
SMARTDETECTOR_MCP_AUTH_TOKEN=
SMARTDETECTOR_MCP_PORT=8083
